<?xml version="1.0" encoding="utf-8"?>
<!--
  Invariant 10: Explicitly exclude all app-private directories from legacy Auto Backup (API <= 30).
  Portable backups must only happen through explicit user-initiated encrypted export.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
    <exclude domain="root" path="." />
</full-backup-content>
